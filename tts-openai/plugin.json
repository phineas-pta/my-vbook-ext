{
	"metadata": {
		"name": "OpenAI-like TTS",
		"author": "phineas-pta",
		"version": 2,
		"description": "OpenAI TTS (support selfhost)",
		"type": "tts",
		"locale": "global"
	},
	"script": {
		"voice": "voice.js",
		"tts": "tts.js"
	},
	"config": {
		"preload_size": 3,
		"preload_parallel": true,
		"max_length": 1000,
		"OPENAI_API_URL": {
			"title": "API endpoint URL (phải kết thúc với đuôi 'v1')",
			"mode": "input",
			"format": "text",
			"default": "https://api.openai.com/v1"
		},
		"OPENAI_API_KEY": {
			"title": "API key",
			"mode": "input",
			"format": "text",
			"default": "sk-EMPTY"
		},
		"OPENAI_API_MODEL": {
			"title": "TTS model",
			"mode": "input",
			"format": "text",
			"default": "gpt-realtime-2.1-mini"
		}
	}
}
